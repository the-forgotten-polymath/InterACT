# LiveKit Server Configuration
# 1. Sign up for free at https://cloud.livekit.io (Free tier gives 50GB/mo free bandwidth)
# 2. Create a project and copy the WebSocket URL, API Key, and API Secret here:
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Set the same URL for direct client exposure if needed
VITE_LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
